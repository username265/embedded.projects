/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
    /* USER CODE BEGIN 1 */

    /* USER CODE END 1 */

    /*
     * HAL 라이브러리와 SysTick 초기화
     */
    HAL_Init();

    /* USER CODE BEGIN Init */

    /* USER CODE END Init */

    /*
     * STM32F446RE 시스템 클록 설정
     */
    SystemClock_Config();

    /* USER CODE BEGIN SysInit */

    /* USER CODE END SysInit */

    /*
     * GPIO 및 I2C 초기화
     */
    MX_GPIO_Init();
    MX_I2C1_Init();

    /* USER CODE BEGIN 2 */

    /*
     * 시작 시 LED 끄기
     */
    HAL_GPIO_WritePin(
        LED_GPIO_Port,
        LED_Pin,
        GPIO_PIN_RESET
    );

    /*
     * MLX90640 초기화
     */
    mlx90640_error_code =
        MLX90640_SensorInit();

    /*
     * 초기화 실패 시 LED를 빠르게 점멸
     */
    if (mlx90640_error_code != 0)
    {
        LED_ErrorBlink(100U);
    }

    /* USER CODE END 2 */

    /* Infinite loop */
    /* USER CODE BEGIN WHILE */

    while (1)
    {
        /*
         * MLX90640 전체 온도 프레임 읽기
         */
        mlx90640_error_code =
            MLX90640_ReadFullFrame();

        if (mlx90640_error_code == 0)
        {
            /*
             * 전체 픽셀 중 최고 온도 계산
             */
            maximum_temperature =
                MLX90640_FindMaximumTemperature();

            /*
             * 60°C 이상인 픽셀 개수 계산
             */
            hot_pixel_count =
                MLX90640_CountHotPixels(
                    TEMPERATURE_THRESHOLD_C
                );

            /*
             * 최고 온도가 60°C 이상이면 LED ON
             */
            if (maximum_temperature >=
                TEMPERATURE_THRESHOLD_C)
            {
                HAL_GPIO_WritePin(
                    LED_GPIO_Port,
                    LED_Pin,
                    GPIO_PIN_SET
                );
            }
            else
            {
                /*
                 * 최고 온도가 60°C 미만이면 LED OFF
                 */
                HAL_GPIO_WritePin(
                    LED_GPIO_Port,
                    LED_Pin,
                    GPIO_PIN_RESET
                );
            }
        }
        else
        {
            /*
             * 프레임 읽기 오류 시 LED OFF
             */
            HAL_GPIO_WritePin(
                LED_GPIO_Port,
                LED_Pin,
                GPIO_PIN_RESET
            );

            HAL_Delay(100U);
        }

        /*
         * 반복 속도 조절
         */
        HAL_Delay(20U);

        /* USER CODE END WHILE */

        /* USER CODE BEGIN 3 */
    }

    /* USER CODE END 3 */
}


