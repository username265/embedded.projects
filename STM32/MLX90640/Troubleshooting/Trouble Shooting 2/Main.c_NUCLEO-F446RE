/**
  * @brief 오류 처리 함수
  * @retval None
  */
void Error_Handler(void)
{
    __disable_irq();

    while (1)
    {
        /*
         * 오류 발생 시 PA5 LED 반복 점멸
         */
        HAL_GPIO_TogglePin(
            LED_GPIO_Port,
            LED_Pin
        );

        /*
         * SysTick 인터럽트가 꺼져 있으므로
         * HAL_Delay 대신 단순 반복문 사용
         */
        for (volatile uint32_t i = 0U;
             i < 500000U;
             i++)
        {
            /*
             * 단순 지연
             */
        }
    }
}


