  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /*
   * HAL 라이브러리, Flash 인터페이스 및 SysTick 초기화
   */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /*
   * 시스템 클록 설정
   */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /*
   * CubeMX에서 설정한 GPIO와 I2C1 초기화
   */
  MX_GPIO_Init();
  MX_I2C1_Init();

  /* USER CODE BEGIN 2 */

  /*
   * 테스트 시작 전에 LED를 끕니다.
   */
  HAL_GPIO_WritePin(
      LED_GPIO_Port,
      LED_Pin,
      GPIO_PIN_RESET
  );

  /*
   * MLX90640이 I2C 주소 0x33에서 응답하는지 확인합니다.
   *
   * MLX90640 주소는 7비트 기준 0x33입니다.
   * STM32 HAL 함수에는 주소를 왼쪽으로 1비트 이동하여 전달합니다.
   *
   * Trials  = 5번 재시도
   * Timeout = 1000 ms
   */
  mlx90640_i2c_status = HAL_I2C_IsDeviceReady(
      &hi2c1,
      (uint16_t)(MLX90640_I2C_ADDR << 1),
      5U,
      1000U
  );

  /*
   * 센서 응답 결과에 따라 LED 상태 결정
   */
  if (mlx90640_i2c_status == HAL_OK)
  {
      /*
       * MLX90640 응답 성공
       * LED를 계속 켭니다.
       */
      HAL_GPIO_WritePin(
          LED_GPIO_Port,
          LED_Pin,
          GPIO_PIN_SET
      );
  }
  else
  {
      /*
       * MLX90640 응답 실패
       * LED를 계속 끕니다.
       */
      HAL_GPIO_WritePin(
          LED_GPIO_Port,
          LED_Pin,
          GPIO_PIN_RESET
      );
  }

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  while (1)
  {
      /*
       * 이 테스트에서는 반복 동작이 필요하지 않습니다.
       *
       * 센서 연결 확인 결과에 따라 LED 상태를 유지합니다.
       */

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }

  /* USER CODE END 3 */
}

