/**
  * @brief MLX90640 센서 초기화
  * @retval 0: 성공, 음수: 오류
  */
static int32_t MLX90640_SensorInit(void)
{
    int32_t status;

    /*
     * 센서가 I2C 주소 0x33에서 응답하는지 확인합니다.
     *
     * HAL_I2C_IsDeviceReady()에는 7비트 주소를
     * 왼쪽으로 한 칸 이동한 값을 전달합니다.
     */
    if (HAL_I2C_IsDeviceReady(
            &hi2c1,
            (uint16_t)(MLX90640_I2C_ADDRESS << 1),
            5U,
            1000U
        ) != HAL_OK)
    {
        return -1;
    }

    /*
     * 센서 EEPROM 보정 데이터 읽기
     */
    status = MLX90640_DumpEE(
        MLX90640_I2C_ADDRESS,
        mlx90640_eeprom
    );

    if (status != 0)
    {
        return -2;
    }

    /*
     * EEPROM에서 보정 파라미터 추출
     */
    status = MLX90640_ExtractParameters(
        mlx90640_eeprom,
        &mlx90640_parameters
    );

    if (status != 0)
    {
        return -3;
    }

    /*
     * Chess mode 설정
     */
    status = MLX90640_SetChessMode(
        MLX90640_I2C_ADDRESS
    );

    if (status != 0)
    {
        return -4;
    }

    /*
     * ADC 해상도 설정
     *
     * 0: 16-bit
     * 1: 17-bit
     * 2: 18-bit
     * 3: 19-bit
     */
    status = MLX90640_SetResolution(
        MLX90640_I2C_ADDRESS,
        3U
    );

    if (status != 0)
    {
        return -5;
    }

    /*
     * Refresh rate 설정
     *
     * 0: 0.5 Hz
     * 1: 1 Hz
     * 2: 2 Hz
     * 3: 4 Hz
     * 4: 8 Hz
     * 5: 16 Hz
     * 6: 32 Hz
     * 7: 64 Hz
     */
    status = MLX90640_SetRefreshRate(
        MLX90640_I2C_ADDRESS,
        3U
    );

    if (status != 0)
    {
        return -6;
    }

    /*
     * 초기 프레임 준비 대기
     */
    HAL_Delay(500U);

    return 0;
}


/**
  * @brief MLX90640의 subpage 0과 subpage 1을 모두 읽습니다.
  * @retval 0: 성공, 음수: 오류
  */
static int32_t MLX90640_ReadFullFrame(void)
{
    uint8_t received_subpages = 0U;
    uint8_t attempt = 0U;

    int32_t subpage;

    float reflected_temperature;

    /*
     * MLX90640은 768개 픽셀을 두 개의 subpage로 나누어
     * 갱신합니다.
     *
     * subpage 0과 subpage 1이 모두 들어올 때까지 반복합니다.
     */
    while ((received_subpages != 0x03U) &&
           (attempt < MLX90640_MAX_FRAME_TRIES))
    {
        subpage = MLX90640_GetFrameData(
            MLX90640_I2C_ADDRESS,
            mlx90640_frame
        );

        /*
         * 성공하면 0 또는 1이 반환됩니다.
         */
        if (subpage < 0)
        {
            return -10;
        }

        if (subpage > 1)
        {
            return -11;
        }

        /*
         * 센서 자체 온도 계산
         */
        ambient_temperature = MLX90640_GetTa(
            mlx90640_frame,
            &mlx90640_parameters
        );

        if (!isfinite(ambient_temperature))
        {
            return -12;
        }

        /*
         * 반사 온도 보정
         */
        reflected_temperature =
            ambient_temperature - 8.0f;

        /*
         * 현재 subpage에 해당하는 픽셀 온도 계산
         */
        MLX90640_CalculateTo(
            mlx90640_frame,
            &mlx90640_parameters,
            MLX90640_EMISSIVITY,
            reflected_temperature,
            mlx90640_temperature
        );

        /*
         * 수신한 subpage 기록
         *
         * subpage 0: bit 0
         * subpage 1: bit 1
         */
        received_subpages |=
            (uint8_t)(1U << (uint8_t)subpage);

        attempt++;
    }

    /*
     * 두 subpage를 모두 얻지 못함
     */
    if (received_subpages != 0x03U)
    {
        return -13;
    }

    /*
     * EEPROM에 기록된 불량 픽셀 보정
     */
    MLX90640_BadPixelsCorrection(
        mlx90640_parameters.brokenPixels,
        mlx90640_temperature,
        1,
        &mlx90640_parameters
    );

    MLX90640_BadPixelsCorrection(
        mlx90640_parameters.outlierPixels,
        mlx90640_temperature,
        1,
        &mlx90640_parameters
    );

    return 0;
}


/**
  * @brief 전체 768개 픽셀 중 최고 온도를 찾습니다.
  * @retval 최고 온도
  */
static float MLX90640_FindMaximumTemperature(void)
{
    float max_temperature = -1000.0f;

    uint16_t max_pixel = 0U;
    uint16_t i;

    for (i = 0U; i < 768U; i++)
    {
        /*
         * NaN 또는 무한대 값 제외
         */
        if (!isfinite(mlx90640_temperature[i]))
        {
            continue;
        }

        /*
         * 정상 측정 범위를 크게 벗어난 값 제외
         */
        if ((mlx90640_temperature[i] < -40.0f) ||
            (mlx90640_temperature[i] > 300.0f))
        {
            continue;
        }

        if (mlx90640_temperature[i] >
            max_temperature)
        {
            max_temperature =
                mlx90640_temperature[i];

            max_pixel = i;
        }
    }

    maximum_temperature_pixel = max_pixel;

    return max_temperature;
}


/**
  * @brief 설정 온도 이상인 픽셀 수를 계산합니다.
  * @param threshold 기준 온도
  * @retval 기준 온도 이상인 픽셀 개수
  */
static uint16_t MLX90640_CountHotPixels(
    float threshold
)
{
    uint16_t count = 0U;
    uint16_t i;

    for (i = 0U; i < 768U; i++)
    {
        if (!isfinite(mlx90640_temperature[i]))
        {
            continue;
        }

        if ((mlx90640_temperature[i] >= threshold) &&
            (mlx90640_temperature[i] <= 300.0f))
        {
            count++;
        }
    }

    return count;
}


/**
  * @brief 센서 초기화 오류를 LED 점멸로 표시합니다.
  * @param delay_ms LED 점멸 간격
  */
static void LED_ErrorBlink(
    uint32_t delay_ms
)
{
    while (1)
    {
        HAL_GPIO_TogglePin(
            LED_GPIO_Port,
            LED_Pin
        );

        HAL_Delay(delay_ms);
    }
}

